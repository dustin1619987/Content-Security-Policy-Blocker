{
  "manifest_version": 3,
  "name": "Disable Content-Security-Policy",
  "version": "1.6.0",
  "description": "Toggle the Content-Security-Policy header for the current tab. Inspect the original CSP, inject a custom one, and switch between light/dark themes.",
  "minimum_chrome_version": "121",
  "permissions": [
    "declarativeNetRequest",
    "webNavigation",
    "webRequest",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "CSP Disabler — click to open",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-off-16.png",
      "32": "icons/icon-off-32.png",
      "48": "icons/icon-off-48.png",
      "128": "icons/icon-off-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-off-16.png",
    "32": "icons/icon-off-32.png",
    "48": "icons/icon-off-48.png",
    "128": "icons/icon-off-128.png"
  }
}
