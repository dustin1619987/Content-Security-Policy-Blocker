{
  "manifest_version": 3,
  "name": "Disable Content-Security-Policy",
  "version": "1.3.1",
  "description": "Toggle the Content-Security-Policy header for the current tab. Green ON = CSP stripped, red OFF = CSP normal.",
  "minimum_chrome_version": "121",
  "permissions": [
    "declarativeNetRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CSP DISABLER: OFF — click to turn on (CSP will be stripped)",
    "default_icon": {
      "16": "icons/icon-off-16.png",
      "32": "icons/icon-off-32.png",
      "48": "icons/icon-off-48.png",
      "128": "icons/icon-off-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-off-16.png",
    "32": "icons/icon-off-32.png",
    "48": "icons/icon-off-48.png",
    "128": "icons/icon-off-128.png"
  }
}
